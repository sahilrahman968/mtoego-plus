MONGODB_URI=mongodb://localhost:27017/ecom
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Cloudinary (required for product image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Category images go to motoego-dev/categories (development) or
# motoego-prod/categories (production), based on NODE_ENV.

# Google OAuth (customer store sign-in)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# SMTP (Gmail: use an App Password, not your normal login password)
# Create at https://myaccount.google.com/apppasswords (2-Step Verification required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=motoegoplus@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=Motoego+ <motoegoplus@gmail.com>
APP_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=motoegoplus@gmail.com
